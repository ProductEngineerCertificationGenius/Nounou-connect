{
  "name": "nounou-connect",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Plateforme de mise en relation entre familles, agences et nounous en Côte d'Ivoire",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
